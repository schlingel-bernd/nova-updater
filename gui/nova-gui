_MD_CODE = re.compile(r"`([^`\n]+)`")
_MD_BOLD = re.compile(r"\*\*([^*\n]+)\*\*")
_MD_ITAL = re.compile(r"(?<![*\w])\*([^*\n]+)\*(?!\*)")
_MD_LINK = re.compile(r"\[([^\]\n]+)\]\(([^)\n]+)\)")
_MD_IMG = re.compile(r"!\[[^\]]*\]\([^)]*\)")


def _md_inline(s):
    """Inline markdown to Pango markup. Escaped FIRST, so nothing in the
    document can inject markup — only then are the markers turned into tags."""
    s = _MD_IMG.sub("", s)
    s = esc(s)
    s = _MD_CODE.sub(r"<tt>\1</tt>", s)
    s = _MD_BOLD.sub(r"<b>\1</b>", s)
    s = _MD_ITAL.sub(r"<i>\1</i>", s)
    s = _MD_LINK.sub(r"<u>\1</u>", s)
    return s


def markdown_widget(text, limit=40000):
    """A README rendered as a document rather than one long dim paragraph.

    Deliberately small: headings, emphasis, inline and fenced code, lists,
    block quotes, rules and tables-as-monospace. Colours come from CSS classes
    so they follow the theme instead of being baked into the markup."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
    para, code, in_code = [], [], False

    def label(markup, css=None, mono=False):
        lbl = Gtk.Label(xalign=0, wrap=True, selectable=True, use_markup=True,
                        label=markup)
        lbl.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        if mono:
            lbl.add_css_class("monospace")
        if css:
            lbl.add_css_class(css)
        return lbl

    def flush_para():
        if para:
            box.append(label(" ".join(para)))
            para.clear()

    def flush_code():
        if code:
            lbl = label("<tt>%s</tt>" % esc("\n".join(code)), "nova-md-code", mono=True)
            lbl.set_wrap(False)
            sc = Gtk.ScrolledWindow(child=lbl, vscrollbar_policy=Gtk.PolicyType.NEVER)
            sc.add_css_class("nova-md-code")
            box.append(sc)
            code.clear()

    for raw in text[:limit].splitlines():
        if raw.lstrip().startswith("```"):
            flush_para()
            in_code = not in_code
            if not in_code:
                flush_code()
            continue
        if in_code:
            code.append(raw)
            continue
        s = raw.strip()
        if not s:
            flush_para()
            continue
        if len(s) >= 3 and set(s) <= set("-=_* "):          # horizontal rule
            flush_para()
            box.append(Gtk.Separator(margin_top=6, margin_bottom=6))
            continue
        m = re.match(r"(#{1,6})\s+(.*)", s)
        if m:
            flush_para()
            lvl = min(3, len(m.group(1)))
            lbl = label(_md_inline(m.group(2)), "nova-md-h%d" % lvl)
            lbl.set_margin_top(8 if lvl > 1 else 12)
            box.append(lbl)
            continue
        if s.startswith(">"):
            flush_para()
            box.append(label(_md_inline(s.lstrip("> ")), "nova-md-quote"))
            continue
        m = re.match(r"[-*+]\s+(.*)", s) or re.match(r"(\d+)[.)]\s+(.*)", s)
        if m:
            flush_para()
            body = m.group(m.lastindex)
            lbl = label("• " + _md_inline(body))
            lbl.set_margin_start(10)
            box.append(lbl)
            continue
        if s.startswith("|"):                               # table: keep aligned
            flush_para()
            code.append(raw)
            continue
        flush_code()
        para.append(_md_inline(s))

    flush_para()
    flush_code()
    return box


def component_chips(components):
    """One chip per component, with the icon that component already maps to."""
    parts = [c for c in (components or "").split() if c]
    if not parts:
        return None
    box = Adw.WrapBox(child_spacing=7, line_spacing=7) if hasattr(Adw, "WrapBox") else \
        Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
    for c in parts:
        names = None
        for key, cands in COMPONENT_ICON:
            if key == c.lower():
                names = cands
                break
        chip = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6,
                       valign=Gtk.Align.CENTER)
        chip.add_css_class("nova-comp")
        chip.append(Gtk.Image(icon_name=best_icon(names or FALLBACK_ICON),
                              pixel_size=14))
        chip.append(Gtk.Label(label=c.replace("-", " ")))
        box.append(chip)
    return box

def find_nova():
    for c in (shutil.which("nova"),
              os.path.expanduser("~/.local/bin/nova"),
              "/usr/local/bin/nova",
              os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "bin", "nova")):
        if c and os.path.exists(c):
            return os.path.realpath(c)
    return None


def pill(text, kind, tip=None):
    lbl = Gtk.Label(label=text, valign=Gtk.Align.CENTER)
    lbl.add_css_class("nova-pill")
    lbl.add_css_class(kind)
    if tip:
        lbl.set_tooltip_text(tip)
    return lbl


# Which halves of an app are in. Only for apps that use the system scope: a
# lone USER pill on every row would be noise, and for a user-only app the
# status pill already says everything. For a dual-scope app this is the thing
# you could not otherwise see anywhere in the GUI — and it is what makes
# "partly installed" mean something specific.
SCOPE_PILL = (
    ("user",   "USER", "ok",   "in your home directory (~/.local)"),
    ("system", "ROOT", "root", "outside your home directory, installed as root"),
)


def scope_pills(app):
    if not app.needs_root:
        return []
    inst = set(app.installed_list)
    out = []
    for scope, label, kind, where in SCOPE_PILL:
        if scope not in app.scope_list:
            continue
        if scope in inst:
            out.append(pill(label, kind, "installed %s" % where))
        else:
            out.append(pill(label, "dim", "NOT installed — %s" % where))
    return out


def icon_for(app):
    """Category first — it says what the thing is *for*, which is what someone
    scanning a long list is actually looking for. Components are the fallback."""
    cat = app["category"].strip().lower()
    if cat in CATEGORY_ICON:
        return best_icon(CATEGORY_ICON[cat])
    for key, names in COMPONENT_ICON:
        if key in app["comp"]:
            return best_icon(names)
    return best_icon(FALLBACK_ICON)


def tint_for(app):
    cat = app["category"].strip().lower()
    return "c%d" % (sum(ord(c) for c in cat) % TINTS if cat else 0)


def tile(app, big=False):
    """A tinted rounded tile with the icon centred inside it.

    The image needs to expand and centre itself: a plain Gtk.Box lays its child
    out at the start, so the icon sits in the corner of the tile and reads as a
    broken glyph rather than an icon."""
    img = Gtk.Image(icon_name=icon_for(app), pixel_size=48 if big else 26)
    img.set_halign(Gtk.Align.CENTER)
    img.set_valign(Gtk.Align.CENTER)
    img.set_hexpand(True)
    img.set_vexpand(True)
    box = Gtk.Box()
    box.append(img)
    box.add_css_class("nova-bigtile" if big else "nova-tile")
    box.add_css_class(tint_for(app))
    box.set_halign(Gtk.Align.START)
    box.set_valign(Gtk.Align.CENTER)
    box.set_hexpand(False)
    return box


class App(GObject.Object):
    """One app, as the CLI described it."""
    __gtype_name__ = "NovaApp"

    def __init__(self, d):
        super().__init__()
        self.d = d

    def __getitem__(self, k):
        return self.d.get(k, "")

    @property
    def scope_list(self):
        return self["scopes"].split()

    @property
    def installed_list(self):
        """The scopes this app is ACTUALLY installed in, which is not the same
        as the scopes it uses — a dual-scope app is routinely half installed."""
        return self["installed_scopes"].split()

    @property
    def needs_root(self):
        return "system" in self.scope_list

    @property
    def is_installed(self):
        return self["status"] in ("installed", "partial", "update-available")

    def haystack(self):
        return " ".join((self["name"], self["desc"], self["tags"],
                         self["category"], self["comp"])).lower()


