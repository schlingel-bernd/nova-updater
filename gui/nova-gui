# Adw.ActionRow titles and subtitles, and Adw.PreferencesGroup descriptions,
# are Pango markup by default. Every one of these strings comes out of an app's
# nova.manifest, so a description containing a bare & rendered the row empty
# and a crafted manifest could inject markup into the row that explains why an
# app wants root.
esc = GLib.markup_escape_text


def repo_path(repo_dir, rel):
    """Resolve a manifest-supplied path inside the app's own clone.

    ICON, SCREENSHOTS and ABOUT are repo-relative by convention but were joined
    to the repo directory unchecked, so an absolute path or one with ../ read
    any file the user can read into the dialog. Returns None unless the result
    stays inside the clone and exists."""
    if not repo_dir or not rel:
        return None
    base = os.path.realpath(repo_dir)
    p = os.path.realpath(os.path.join(base, rel))
    if p != base and not p.startswith(base + os.sep):
        return None
    return p if os.path.exists(p) else None

