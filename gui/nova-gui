class ShotDialog(Adw.Dialog):
    """The screenshots, big, with the whole set to hand.

    No zoom control. These are screenshots of desktop apps, so at this size
    they are already at or near 1:1 and a zoom widget only put chrome in front
    of the picture. What was actually missing was a way to move around the set:
    swipe, arrow keys, the scroll wheel, dots, and a strip showing what else
    there is rather than leaving you to discover it."""

    def __init__(self, paths, index=0):
        super().__init__(title="Screenshots")
        self.set_content_width(1180)
        self.set_content_height(820)
        self.paths = list(paths)
        self.thumbs = []
        if not self.paths:
            # The detail view only offers the button when there are shots, so
            # this is unreachable from the GUI — but a viewer with nothing to
            # view should say so rather than raise on paths[0].
            self.set_child(Adw.StatusPage(
                icon_name=ui_icon("image-missing-symbolic", "image-missing"),
                title="No screenshots"))
            return
        paths = self.paths
        self._index = max(0, min(len(paths) - 1, index))

        # the wheel moves between shots now that it is not spent on zooming
        self.car = Adw.Carousel(allow_scroll_wheel=True, spacing=24,
                                hexpand=True, vexpand=True)
        for path in paths:
            pic = Gtk.Picture.new_for_filename(path)
            pic.set_content_fit(Gtk.ContentFit.CONTAIN)
            pic.set_can_shrink(True)
            pic.add_css_class("nova-shot")
            self.car.append(pic)
        self.car.connect("page-changed", self._on_page)

        self.title_w = Adw.WindowTitle(title="", subtitle="")
        header = Adw.HeaderBar()
        header.set_title_widget(self.title_w)
        if len(paths) > 1:
            nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
            nav.add_css_class("linked")
            prev = Gtk.Button(icon_name=ui_icon("go-previous-symbolic", "go-previous"),
                              tooltip_text="Previous  (\u2190)")
            nxt = Gtk.Button(icon_name=ui_icon("go-next-symbolic", "go-next"),
                             tooltip_text="Next  (\u2192)")
            prev.connect("clicked", lambda *_: self._step(-1))
            nxt.connect("clicked", lambda *_: self._step(1))
            nav.append(prev)
            nav.append(nxt)
            header.pack_start(nav)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        body.append(self.car)
        if len(paths) > 1:
            body.append(Adw.CarouselIndicatorDots(carousel=self.car))
            body.append(self._strip())

        tb = Adw.ToolbarView(content=body)
        tb.add_top_bar(header)
        self.set_child(tb)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_key)
        self.add_controller(keys)

        self._on_page(self.car, self._index)
        if self._index:
            # the carousel has to be allocated before it can scroll anywhere
            GLib.idle_add(self._goto, self._index)

    def _strip(self):
        """A thumbnail per shot, so the set is visible instead of being
        something you find out about by swiping."""
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                      halign=Gtk.Align.CENTER)
        for i, path in enumerate(self.paths):
            pic = Gtk.Picture.new_for_filename(path)
            pic.set_content_fit(Gtk.ContentFit.COVER)
            pic.set_size_request(104, 62)
            pic.add_css_class("nova-shot")
            btn = Gtk.Button(child=pic, tooltip_text=os.path.basename(path))
            btn.add_css_class("flat")
            btn.add_css_class("nova-shot-btn")
            btn.connect("clicked", lambda _b, idx=i: self._goto(idx))
            self.thumbs.append(btn)
            box.append(btn)
        sc = Gtk.ScrolledWindow(child=box, vscrollbar_policy=Gtk.PolicyType.NEVER)
        sc.set_size_request(-1, 76)
        sc.set_margin_bottom(10)
        return sc

    def _goto(self, i):
        i = max(0, min(len(self.paths) - 1, i))
        page = self.car.get_nth_page(i)
        try:
            self.car.scroll_to(page, True)
        except TypeError:            # libadwaita < 1.2 took no animate argument
            self.car.scroll_to(page)
        return False

    def _step(self, by):
        self._goto(self._index + by)

    def _on_page(self, _car, index):
        self._index = int(index)
        self.title_w.set_title(os.path.basename(self.paths[self._index]))
        self.title_w.set_subtitle("%d of %d" % (self._index + 1, len(self.paths))
                                  if len(self.paths) > 1 else "")
        for i, btn in enumerate(self.thumbs):
            if i == self._index:
                btn.add_css_class("nova-thumb-on")
            else:
                btn.remove_css_class("nova-thumb-on")

    def _on_key(self, _c, keyval, _code, _state):
        if keyval in (Gdk.KEY_Left, Gdk.KEY_Up, Gdk.KEY_Page_Up):
            self._step(-1)
            return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_Down, Gdk.KEY_Page_Down, Gdk.KEY_space):
            self._step(1)
            return True
        if keyval == Gdk.KEY_Home:
            self._goto(0)
            return True
        if keyval == Gdk.KEY_End:
            self._goto(len(self.paths) - 1)
            return True
        return False


class DetailDialog(Adw.Dialog):
    """Everything about one app — including the parts that should make you
    think twice: what it installs, what it needs, and why it wants root."""

    def __init__(self, win, app):
        super().__init__(title=app["name"])
        self.set_content_width(720)
        self.set_content_height(780)
        self.win = win
        self.app = app

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                           margin_top=18, margin_bottom=24,
                           margin_start=18, margin_end=18)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                      vexpand=True)
        scroller.set_child(Adw.Clamp(child=self.box, maximum_size=680))

        tb = Adw.ToolbarView(content=scroller)
        header = Adw.HeaderBar()
        self.action_btn = Gtk.Button()
        self.action_btn.add_css_class("suggested-action")
        self.action_btn.connect("clicked", self._on_action)
        header.pack_end(self.action_btn)
        self.remove_btn = Gtk.Button(label="Uninstall")
        self.remove_btn.add_css_class("destructive-action")
        self.remove_btn.connect("clicked", lambda *_: self._run("uninstall"))
        header.pack_end(self.remove_btn)
        tb.add_top_bar(header)
        self.set_child(tb)

        self._build_header()
        self._placeholder = Gtk.Spinner(spinning=True, height_request=48)
        self.box.append(self._placeholder)
        threading.Thread(target=self._load, daemon=True).start()

    def _build_header(self):
        a = self.app
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        self.big_icon = tile(a, big=True)
        self.big_icon.set_valign(Gtk.Align.START)
        row.append(self.big_icon)

        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, hexpand=True)
        title = Gtk.Label(label=a["name"], xalign=0)
        title.add_css_class("title-1")
        col.append(title)
        sub = Gtk.Label(label=a["desc"], xalign=0, wrap=True)
        sub.add_css_class("dim-label")
        col.append(sub)

        chips = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        label, kind = STATUS.get(a["status"], ("", "dim"))
        if label:
            chips.append(pill(label.upper(), kind))
        for p in scope_pills(a):
            chips.append(p)
        if a["pinned"]:
            chips.append(pill("PINNED %s" % a["pinned"], "warn"))
        if a["category"]:
            chips.append(pill(a["category"].upper(), "dim"))
        col.append(chips)
        row.append(col)
        self.box.append(row)
        self._sync_buttons()

    def _sync_buttons(self):
        st = self.app["status"]
        self.action_btn.set_label(
            "Update" if st == "update-available"
            else "Complete install" if st == "partial"
            else "Reinstall" if st == "installed" else "Install")
        self.remove_btn.set_visible(self.app.is_installed)

    def _on_action(self, *_):
        self._run("update" if self.app["status"] == "update-available" else "install")

    def _run(self, verb):
        self.close()
        self.win.run_action(verb, [self.app["name"]])

    # ---- how this app tracks versions ------------------------------------
    def _version_group(self, info):
        """ref= on a list entry has always existed; `nova pin` made it a
        command. It belongs here too: "stay on this version" is a decision you
        make while looking at an app, not while editing a list file."""
        g = Adw.PreferencesGroup(
            title="Updates",
            description="Pinned apps are left alone by updates until you unpin them.")
        pinned = info.get("pinned", "")
        if pinned:
            r = Adw.ActionRow(title="Pinned",
                              subtitle=esc("held at %s" % pinned))
            b = Gtk.Button(label="Unpin", valign=Gtk.Align.CENTER)
            b.add_css_class("flat")
            b.connect("clicked", lambda *_: self._pin(""))
            r.add_suffix(b)
            g.add(r)
        else:
            r = Adw.EntryRow(title="Pin to a tag or branch")
            r.set_show_apply_button(True)
            r.connect("apply", lambda w: self._pin(w.get_text().strip()))
            g.add(r)
        return g

    def _pin(self, ref):
        name = self.app["name"]
        self.close()
        self.win.run_cli(["pin", name, ref] if ref else ["unpin", name])

    # ---- what is about to run -------------------------------------------
    def _inspect_group(self, info):
        """The two things worth reading before letting code run: the installer
        itself, and — when an update is waiting — what that update changes.
        Both are the CLI's own output, loaded only if you ask for it."""
        g = Adw.PreferencesGroup(
            title="Before you run it",
            description="An app's installer is the whole of what installing it does.")
        name = self.app["name"]

        e = Adw.ExpanderRow(title="Installer",
                            subtitle=esc(info.get("installer") or "install.sh"))
        self._lazy_text(e, [self.win.nova, "info", "--installer", name])
        g.add(e)

        if self.app["status"] == "update-available":
            e2 = Adw.ExpanderRow(title="What this update changes",
                                 subtitle="commits, files, and the installer's own diff")
            self._lazy_text(e2, [self.win.nova, "diff", name])
            g.add(e2)
        return g

    @staticmethod
    def _lazy_text(expander, argv, empty="(nothing to show)"):
        """Fill an expander the first time it is opened, off the UI thread.

        Lazily, because running every app's installer through a subprocess just
        to build a dialog nobody expanded would make opening one slow."""
        buf = Gtk.TextBuffer()
        view = Gtk.TextView(buffer=buf, editable=False, monospace=True,
                            top_margin=8, bottom_margin=8,
                            left_margin=8, right_margin=8)
        view.set_wrap_mode(Pango.WrapMode.NONE)
        scroll = Gtk.ScrolledWindow(child=view)
        scroll.set_size_request(-1, 280)
        expander.add_row(scroll)
        loaded = []

        def fill(text):
            buf.set_text(text)
            return False

        def on_expanded(*_):
            if loaded or not expander.get_expanded():
                return
            loaded.append(1)
            buf.set_text("loading…")

            def worker():
                try:
                    p = subprocess.run(argv, capture_output=True, text=True,
                                       stdin=subprocess.DEVNULL, timeout=180)
                    out = (p.stdout or "") + (p.stderr or "")
                except Exception as e:  # noqa: BLE001
                    out = str(e)
                GLib.idle_add(fill, out.strip() or empty)

            threading.Thread(target=worker, daemon=True).start()

        expander.connect("notify::expanded", on_expanded)

    def _load(self):
        try:
            out = subprocess.run([self.win.nova, "info", "--porcelain", self.app["name"]],
                                 capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=120).stdout
        except Exception as e:  # noqa: BLE001
            out = ""
            GLib.idle_add(self.win.append_log, "info failed: %s\n" % e)
        info = {}
        for line in out.splitlines():
            k, _, v = line.partition("=")
            info[k] = v
        GLib.idle_add(self._populate, info)

    def _populate(self, info):
        self.box.remove(self._placeholder)
        rd = info.get("repo_dir", "")

        icon = repo_path(rd, info.get("icon", ""))
        if icon:
            pic = Gtk.Image.new_from_file(icon)
            pic.set_pixel_size(96)
            parent = self.big_icon.get_parent()
            parent.insert_child_after(pic, None)
            parent.remove(self.big_icon)
            self.big_icon = pic

        shots = [repo_path(rd, p) for p in info.get("screenshots", "").split()]
        shots = [p for p in shots if p]
        if shots:
            # spacing, so two screenshots stop touching; and each one opens a
            # viewer, because a 320px-tall thumbnail of a screenshot is not
            # something you can read
            car = Adw.Carousel(allow_scroll_wheel=False, spacing=14)
            car.set_size_request(-1, 320)
            for i, p in enumerate(shots):
                pic = Gtk.Picture.new_for_filename(p)
                pic.set_content_fit(Gtk.ContentFit.CONTAIN)
                pic.add_css_class("nova-shot")
                btn = Gtk.Button(child=pic, tooltip_text="Open full size")
                btn.add_css_class("flat")
                btn.add_css_class("nova-shot-btn")
                btn.connect("clicked",
                            lambda _b, idx=i: ShotDialog(shots, idx).present(self))
                car.append(btn)
            self.box.append(car)
            if len(shots) > 1:
                self.box.append(Adw.CarouselIndicatorDots(carousel=car))

        facts = Adw.PreferencesGroup(title="About")
        got = False
        for key, label in (("version", "Version"), ("author", "Author"),
                           ("license", "License"), ("category", "Category")):
            if info.get(key):
                facts.add(Adw.ActionRow(title=label, subtitle=esc(info[key])))
                got = True
        if info.get("homepage"):
            r = Adw.ActionRow(title="Homepage", subtitle=esc(info["homepage"]),
                              activatable=True)
            r.add_suffix(Gtk.Image(icon_name=ui_icon("adw-external-link-symbolic", "external-link", "go-jump")))
            r.connect("activated", lambda *_: Gtk.UriLauncher(
                uri=info["homepage"]).launch(self.win, None, None, None))
            facts.add(r)
            got = True
        if got:
            self.box.append(facts)

        inst = Adw.PreferencesGroup(title="What it installs")
        chips = component_chips(info.get("components"))
        if chips:
            holder = Adw.PreferencesRow(activatable=False, selectable=False)
            chips.set_margin_top(12)
            chips.set_margin_bottom(12)
            chips.set_margin_start(12)
            chips.set_margin_end(12)
            holder.set_child(chips)
            inst.add(holder)
        scopes = info.get("scopes", "").split()
        # `nova info --porcelain` has reported installed_<scope> all along; the
        # dialog never showed it, so there was nowhere in the GUI that said
        # which half of a dual-scope app was actually on the machine.
        def state(sc):
            there = info.get("installed_%s" % sc) == "1"
            return pill("INSTALLED" if there else "NOT INSTALLED",
                        ("ok" if sc == "user" else "root") if there else "dim")
        if "user" in scopes:
            r = Adw.ActionRow(
                title="Into your home directory",
                subtitle="~/.local — no password needed, survives a system rebase")
            r.add_suffix(state("user"))
            inst.add(r)
        if "system" in scopes:
            r = Adw.ActionRow(
                title="Outside your home directory",
                subtitle=esc(info.get("root_reason")
                             or "installs files and services system-wide"))
            r.add_prefix(Gtk.Image(icon_name=ui_icon("dialog-warning-symbolic", "dialog-warning")))
            r.add_suffix(state("system"))
            inst.add(r)
        self.box.append(inst)

        self.box.append(self._version_group(info))
        self.box.append(self._inspect_group(info))

        deps = info.get("depends", "").split()
        if deps:
            missing = set(info.get("depends_missing", "").split())
            g = Adw.PreferencesGroup(
                title="Needs",
                description=("Something is missing — the installer may fail"
                             if missing else "All present on this machine"))
            for d in deps:
                r = Adw.ActionRow(title=esc(d))
                ok = d not in missing
                img = Gtk.Image(icon_name=ui_icon("object-select-symbolic", "object-select", "emblem-ok") if ok
                                else ui_icon("dialog-warning-symbolic", "dialog-warning"))
                img.add_css_class("nova-dep-ok" if ok else "nova-dep-bad")
                r.add_suffix(img)
                g.add(r)
            self.box.append(g)

        about = repo_path(rd, info.get("about", ""))
        if about:
            try:
                text = open(about, encoding="utf-8", errors="replace").read()
            except OSError:
                text = ""
            if text.strip():
                # Rendered, and behind an expander like the installer: a README
                # is often the longest thing in the dialog, and it used to be
                # stripped of its code blocks and tables and flattened into one
                # dim paragraph.
                g = Adw.PreferencesGroup(title="Read me")
                e = Adw.ExpanderRow(title=os.path.basename(about),
                                    subtitle="the project's own README")
                body = markdown_widget(text)
                body.set_margin_top(12)
                body.set_margin_bottom(14)
                body.set_margin_start(14)
                body.set_margin_end(14)
                sc = Gtk.ScrolledWindow(child=body,
                                        hscrollbar_policy=Gtk.PolicyType.NEVER)
                sc.set_size_request(-1, 420)
                e.add_row(sc)
                b = Gtk.Button(label="Open", valign=Gtk.Align.CENTER)
                b.add_css_class("flat")
                b.connect("clicked", lambda *_, t=text, n=os.path.basename(about):
                          ReadmeDialog(t, n).present(self))
                e.add_suffix(b)
                g.add(e)
                self.box.append(g)

        src = Adw.PreferencesGroup(title="Source")
        r = Adw.ActionRow(title="Repository", subtitle=esc(info.get("url", "")))
        r.set_subtitle_lines(2)
        src.add(r)
        self.box.append(src)
        return False


class CatalogDialog(Adw.Dialog):
    """Add, inspect and remove catalogs.

    Catalogs are opt-in: nothing appears in the explorer until one is added.
    That is a security property, not an oversight, so adding one says plainly
    what it means rather than treating it as a bookmark."""

    def __init__(self, win):
        super().__init__(title="Catalogs")
        self.set_content_width(620)
        self.set_content_height(560)
        self.win = win

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                           margin_top=18, margin_bottom=18,
                           margin_start=18, margin_end=18)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                      vexpand=True)
        scroller.set_child(Adw.Clamp(child=self.box, maximum_size=580))
        tb = Adw.ToolbarView(content=scroller)
        tb.add_top_bar(Adw.HeaderBar())
        self.set_child(tb)
        self.reload()

    def reload(self):
        child = self.box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.box.remove(child)
            child = nxt

        add = Adw.PreferencesGroup(
            title="Add a catalog",
            description="A catalog is a git repo listing apps. Adding one lets "
                        "those apps run their own installers on this machine, "
                        "and an app that declares the system scope runs its "
                        "installer as root. Add catalogs you trust.")
        self.entry = Adw.EntryRow(title="Catalog git URL")
        self.entry.set_show_apply_button(True)
        self.entry.connect("apply", lambda w: self._add(w.get_text().strip()))
        add.add(self.entry)
        self.box.append(add)

        g = Adw.PreferencesGroup(title="Registered")
        rows = 0
        try:
            out = subprocess.run([self.win.nova, "catalog", "list", "--porcelain"],
                                 capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=60).stdout
        except Exception as e:  # noqa: BLE001
            out = ""
            self.win.append_log("catalog list failed: %s\n" % e)
        for line in out.splitlines():
            p = line.split("\t")
            if len(p) < 2:
                continue
            name, url = p[0], p[1]
            count = p[2] if len(p) > 2 else "?"
            desc = p[3] if len(p) > 3 else ""
            row = Adw.ActionRow(title=GLib.markup_escape_text(name))
            row.set_subtitle(GLib.markup_escape_text(
                "%s app(s)  ·  %s" % (count, desc or url)))
            row.set_subtitle_lines(2)
            rm = Gtk.Button(icon_name=ui_icon("user-trash-symbolic", "user-trash"),
                            valign=Gtk.Align.CENTER,
                            tooltip_text="Remove this catalog")
            rm.add_css_class("flat")
            rm.add_css_class("error")
            rm.connect("clicked", lambda _b, u=url, n=name: self._remove(u, n))
            row.add_suffix(rm)
            g.add(row)
            rows += 1
        if not rows:
            g.add(Adw.ActionRow(
                title="No catalogs yet",
                subtitle="Nothing is listed until you add one"))
        self.box.append(g)

    def _add(self, url):
        if not url:
            return
        self.entry.set_text("")
        self.win.run_catalog(["catalog", "add", url], self)

    def _remove(self, url, name):
        dlg = Adw.AlertDialog(
            heading="Remove %s?" % name,
            body="Its apps disappear from the list. Anything already installed "
                 "stays until you uninstall it.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("remove", "Remove")
        dlg.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.connect("response", lambda _d, r: r == "remove"
                    and self.win.run_catalog(["catalog", "remove", url], self))
        dlg.present(self)


class DoctorDialog(Adw.Dialog):
    """`nova doctor`, shown rather than buried in the log pane.

    Every condition it checks is one that used to be invisible until it bit
    someone — a stale lock, a root copy frozen releases back, a list root
    silently ignores, a timer that never got enabled. That is worth a window
    you can read, not a toast."""

    def __init__(self, win):
        super().__init__(title="Check this install")
        self.nova = win.nova
        self.set_content_width(680)
        self.set_content_height(620)

        self.buf = Gtk.TextBuffer()
        view = Gtk.TextView(buffer=self.buf, editable=False, monospace=True,
                            top_margin=10, bottom_margin=10,
                            left_margin=10, right_margin=10)
        view.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        scroll = Gtk.ScrolledWindow(child=view, vexpand=True)

        self.banner = Adw.StatusPage(
            icon_name=ui_icon("content-loading-symbolic", "content-loading"),
            title="Checking…")
        self.stack = Gtk.Stack()
        self.stack.add_named(self.banner, "busy")
        self.stack.add_named(scroll, "out")

        tb = Adw.ToolbarView(content=self.stack)
        header = Adw.HeaderBar()
        self.again = Gtk.Button(label="Check again")
        self.again.connect("clicked", lambda *_: self.run())
        header.pack_end(self.again)
        tb.add_top_bar(header)
        self.set_child(tb)
        self.run()

    def run(self):
        self.stack.set_visible_child_name("busy")
        self.again.set_sensitive(False)

        def worker():
            try:
                p = subprocess.run([self.nova, "doctor"],
                                   capture_output=True, text=True,
                                   stdin=subprocess.DEVNULL, timeout=300)
                out, rc = (p.stdout or "") + (p.stderr or ""), p.returncode
            except Exception as e:  # noqa: BLE001
                out, rc = str(e), 1
            GLib.idle_add(self._done, out, rc)

        threading.Thread(target=worker, daemon=True).start()

    def _done(self, out, rc):
        self.buf.set_text(out.strip() or "(no output)")
        self.stack.set_visible_child_name("out")
        self.again.set_sensitive(True)
        self.set_title("Check this install — %s" %
                       ("all clear" if rc == 0 else "needs attention"))
        return False


